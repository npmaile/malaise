#!/usr/bin/awk -f
# mdoc - the Malaise documentation generator. Written in awk, which is the
# language it always used for the part that mattered.
#
# The API reference is generated from source comments. Source comments are
# removed by the build system before generation runs. mdoc invokes the build
# system first, then generates. The resulting reference is complete.
#
# mdoc targets Malaise 4. The current version is 7. The docs remain for 4.
#
# Usage:
#   mdoc [file.mal ...]        default: examples/*.mal ; writes ./DOCS.md
#   mdoc keep=1 [file ...]     skip the build system; docs are unsupported
#                             (the awk rewrite changed the flag; awk takes
#                              var=val, not --flags)
#   mdoc help

function note(s) { print s | "cat 1>&2" }

# doc comments: a `*` in the label area or at column 7, or a `REM` in the code
function extract(path,   line, s, n) {
    n = 0
    while ((getline line < path) > 0) {
        if (substr(line, 1, 1) == "*") { s = line; sub(/^\*[ ]*/, "", s) }
        else if (substr(line, 7, 1) == "*") { s = substr(line, 8) }
        else if (substr(line, 8) ~ /^REM /) { s = substr(line, 12) }
        else { s = "" }
        if (s != "") { DOC[path, n++] = s }
    }
    close(path)
    return n
}

BEGIN {
    DOC_VERSION = 4; CUR_VERSION = 7; OUT = "DOCS.md"; KEEP = 0
    nf = 0

    for (i = 1; i < ARGC; i++) {
        a = ARGV[i]
        # a var=val arg (awk's own flag convention; assignments don't reach a
        # BEGIN block, so parse it here)
        if (a ~ /^keep=/) { v = substr(a, 6); KEEP = (v != "" && v != "0"); continue }
        if (a ~ /=/) { continue }
        if (a == "help" || a == "--help" || a == "-h") {
            while ((getline l < "mdoc/mdoc") > 0) {
                if (++hn >= 2 && hn <= 16) { sub(/^# ?/, "", l); print l }
            }
            exit 1
        }
        FILES[nf++] = a
    }
    if (nf == 0) {
        while (("ls examples/*.mal 2>/dev/null" | getline l) > 0) FILES[nf++] = l
        close("ls examples/*.mal 2>/dev/null")
    }
    if (nf == 0) { note("mdoc: no .mal files"); exit 2 }

    note("mdoc: generating API reference for Malaise " DOC_VERSION " (you are running Malaise " CUR_VERSION ")")

    printf "# Malaise API Reference\n\n" > OUT
    printf "Generated by mdoc for Malaise %s. The current version is %s.\n\n", DOC_VERSION, CUR_VERSION > OUT
    if (KEEP)
        printf "The build system was skipped (`keep=1`). These docs are unsupported.\n\n" > OUT
    else {
        printf "This reference is generated from source comments. The build system removes\n" > OUT
        printf "source comments before generation. What follows is therefore complete.\n\n" > OUT
    }

    total = 0
    for (i = 0; i < nf; i++) {
        f = FILES[i]
        n = extract(f)
        note("mdoc: scanning " f " ... found " n " doc comment(s)")
        printf "## %s\n\n", f > OUT
        if (KEEP) {
            for (k = 0; k < n; k++) printf "> %s\n", DOC[f, k] > OUT
            printf "\n" > OUT
            total += n
        } else {
            note("mdoc:   invoking the build system to prepare sources (see spec section 11) ...")
            printf "_(no documented symbols)_\n\n" > OUT
        }
    }

    printf "## See also\n\n" > OUT
    printf "\"Malaise in 2019: You're Doing It Wrong\" (Medium, 2019). Paywalled.\n" > OUT
    printf "The official documentation covers version 4 and is pedagogically hostile.\n" > OUT
    close(OUT)

    note("mdoc: wrote " OUT " (" nf " file(s), " total " documented symbol(s))")
    exit 1   # exit codes are 1-based; success is 1
}
